{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bootstrap-sha": "a419bfbbeeb958f66d5b11b225bd06c7dff5960f",
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "pull-request-header": "Prepare the next design system release.",
  "pull-request-footer": "",
  "packages": {
    ".": {
      "package-name": "valence-design-system",
      "exclude-paths": [
        ".github",
        "apps",
        "docs",
        "scripts",
        "tests",
        "CONTRIBUTING.md",
        "README.md"
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "packages/react/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/react-native/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/tokens/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/types/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
