{
  "name": "@valencesoftwareio/tokens",
  "repository": {
    "type": "git",
    "url": "https://github.com/valencesoftwareio/valence-design-system.git",
    "directory": "packages/tokens"
  },
  "version": "0.3.0",
  "description": "Valence design tokens — color, typography, spacing, radius. Compiled by Style Dictionary to CSS custom properties (web) and a typed theme object (native).",
  "license": "MIT",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/js/index.js",
  "types": "./dist/js/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/index.js"
    },
    "./css": "./dist/css/tokens.css",
    "./fonts/*": "./dist/fonts/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "style-dictionary": "^4.4.0",
    "typescript": "^5.9.3"
  }
}
