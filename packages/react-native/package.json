{
  "name": "@valencesoftwareio/react-native",
  "repository": {
    "type": "git",
    "url": "https://github.com/valencesoftwareio/valence-design-system.git",
    "directory": "packages/react-native"
  },
  "version": "0.3.0",
  "description": "Valence design system — React Native components.",
  "license": "MIT",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./useValenceFonts": {
      "types": "./dist/hooks/useValenceFonts.d.ts",
      "default": "./dist/hooks/useValenceFonts.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "peerDependencies": {
    "@gorhom/bottom-sheet": ">=5",
    "@react-native-community/slider": ">=5",
    "@react-native-picker/picker": "^2.11.4",
    "expo-font": ">=12",
    "react": ">=19",
    "react-native": ">=0.82",
    "react-native-gesture-handler": ">=2",
    "react-native-reanimated": ">=4",
    "react-native-safe-area-context": ">=5",
    "react-native-svg": ">=13"
  },
  "peerDependenciesMeta": {
    "expo-font": {
      "optional": true
    }
  },
  "dependencies": {
    "@react-native/normalize-colors": ">=0.74.0",
    "@valencesoftwareio/tokens": "workspace:*",
    "@valencesoftwareio/types": "workspace:*",
    "react-native-calendars": "^1.1314.0"
  },
  "devDependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-community/slider": "^5.0.1",
    "@react-native-picker/picker": "^2.11.4",
    "@react-native/babel-preset": "^0.86.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "expo-font": "^57.0.1",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-svg": "^15.14.0",
    "test-renderer": "^1.2.0",
    "typescript": "^5.9.3"
  }
}
